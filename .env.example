APP_ENV=development

# Database
POSTGRES_DB=lawfirm
POSTGRES_USER=lawfirm
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://lawfirm:change-me@localhost:5433/lawfirm
# Ambiente local explícito; usado quando APP_ENV=development/demo.
LOCAL_DATABASE_URL=postgresql+asyncpg://lawfirm:change-me@localhost:5433/lawfirm
# Neon PostgreSQL; obrigatório quando APP_ENV=production. Use sslmode=require.
NEON_DATABASE_URL=postgresql+asyncpg://user:password@ep-example.neon.tech/lawfirm?sslmode=require

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320
REFRESH_TOKEN_EXPIRE_DAYS=3
INITIAL_MASTER_EMAIL=master@example.com
INITIAL_MASTER_PASSWORD=replace-with-a-strong-password
INITIAL_FIRM_NAME=LawFirm Demo
INITIAL_EMPLOYEE_EMAIL=ana.silva@example.com
INITIAL_EMPLOYEE_PASSWORD=Demo@123456
INITIAL_CLIENT_EMAIL=mariana.costa@example.com
INITIAL_CLIENT_PASSWORD=Client@123456

# Integrations (backend only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Frontend
FRONTEND_BASE_URL=http://localhost:5173
# URL pública gerada pelo Render para esta API.
RENDER_EXTERNAL_URL=
VITE_API_BASE_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:5173
