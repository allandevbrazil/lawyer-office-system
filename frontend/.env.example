# API pública usada pelo navegador. Nunca inclua segredos em variáveis VITE_*
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Produção: substitua pela URL pública da API, por exemplo:
# VITE_API_BASE_URL=https://api.example.com/api/v1
# Em produção, configure VITE_APP_ENV=production e a URL pública do serviço Render.
